{
  "manifest_version": 3,
  "name": "Tab Cycler",
  "version": "1.0.0",
  "description": "Automatically close tabs that have been inactive for a set time. Toggle on/off and whitelist tabs you want to keep.",
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Cycler",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}